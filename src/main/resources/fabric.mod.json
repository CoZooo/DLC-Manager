{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "license": "All Rights Reserved",
  "environment": "*",
  "icon": "assets/dlc_manager/textures/gui/icon.png",
  "entrypoints": {
    "main": [
      "com.cozooo.dlc_manager.DlcManager"
    ],
    "client": [
      "com.cozooo.dlc_manager.DlcManagerClient"
    ],
    "modmenu": [
      "com.cozooo.dlc_manager.client.ModMenuCompat"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${mc_version_range}",
    "fabric-api": ">=${fabric_api_version_range}",
    "architectury": "*",
    "java": ">=${java_version}"
  },
  "suggests": {
    "malilib": ">=${malilib_version}"
  }
}
