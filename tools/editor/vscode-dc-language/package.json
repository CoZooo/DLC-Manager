{
  "name": "dc-language-tools",
  "displayName": "DC Language Tools",
  "description": "Syntax highlighting, diagnostics, and completion for .dc files",
  "version": "1.2.1",
  "publisher": "cozooo",
  "icon": "icons/plugin-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:dc",
    "onCommand:dc.pickHexColor"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dc",
        "aliases": [
          "DC",
          "dc"
        ],
        "extensions": [
          ".dc"
        ],
        "icon": {
          "light": "./icons/dc-light.svg",
          "dark": "./icons/dc-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dc",
        "scopeName": "source.dc",
        "path": "./syntaxes/dc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dc.pickHexColor",
        "title": "DC: Pick Hex Color"
      }
    ],
    "snippets": [
      {
        "language": "dc",
        "path": "./snippets/dc.json"
      }
    ]
  }
}
