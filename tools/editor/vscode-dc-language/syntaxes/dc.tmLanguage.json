{
  "name": "DC",
  "scopeName": "source.dc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#categories"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keys"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.dc",
          "match": "//.*$"
        },
        {
          "name": "comment.line.dc",
          "match": "#.*$"
        }
      ]
    },
    "categories": {
      "patterns": [
        {
          "match": "^\\s*(\\[)(.*?)(\\])(?=\\s*(?://|#|$))",
          "captures": {
            "1": {
              "name": "punctuation.definition.section.begin.dc"
            },
            "2": {
              "name": "entity.name.section.dc"
            },
            "3": {
              "name": "punctuation.definition.section.end.dc"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.multi.dc",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.multi.dc",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.dc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.dc",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.dc",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_-]*)\\s*(=|:)",
          "captures": {
            "1": {
              "name": "entity.name.type.property.dc"
            },
            "2": {
              "name": "keyword.operator.assignment.dc"
            }
          }
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.dc",
          "match": "(?i:(?<![\\w])(?:true|false|null)(?![\\w]))"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.dc",
          "match": "(?<![\\w])(?:[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)(?![\\w])"
        }
      ]
    }
  }
}
