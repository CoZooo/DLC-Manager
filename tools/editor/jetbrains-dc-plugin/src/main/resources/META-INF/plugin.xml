<idea-plugin>
    <id>com.cozooo.dlc_manager.dc</id>
    <name>DC Language Support</name>
    <vendor email="dev@cozooo.com" url="https://github.com/CoZooo/DLC-Manager">CoZooo</vendor>

    <description><![CDATA[
    Edit <code>.dc</code> configuration files with:
    <ul>
      <li>syntax highlighting and syntax checks</li>
      <li>generic DC syntax without bundled application fields</li>
      <li>document formatting with Reformat Code</li>
      <li>hex color completion, previews and a color picker</li>
      <li>customizable syntax colors</li>
    </ul>
    Supports compatible IntelliJ Platform IDEs, including Community editions.
    Requires Java 17 or newer; the IDE runtime can usually be used.
    <p>Use, modification, and redistribution are subject to the included PolyForm Shield License 1.0.0; competing products and services are prohibited.
    <a href="https://github.com/CoZooo/DLC-Manager/blob/main/LICENSING.md">Licensing details</a>.</p>
    <p><a href="https://github.com/CoZooo/DLC-Manager">Project and user guides</a> ·
    <a href="https://github.com/CoZooo/DLC-Manager/issues">Report an issue</a></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="DC"
                language="DC"
                implementationClass="com.cozooo.dlc_manager.dc.DCFileType"
                fieldName="INSTANCE"
                extensions="dc"/>
        <lang.parserDefinition
                language="DC"
                implementationClass="com.cozooo.dlc_manager.dc.DCParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="DC"
                implementationClass="com.cozooo.dlc_manager.dc.DCSyntaxHighlighterFactory"/>
        <colorSettingsPage
                language="DC"
                implementationClass="com.cozooo.dlc_manager.dc.DCColorSettingsPage"/>
        <completion.contributor
                language="DC"
                implementationClass="com.cozooo.dlc_manager.dc.DCCompletionContributor"/>
        <codeInsight.inlayProvider
                language="DC"
                implementationClass="com.cozooo.dlc_manager.dc.DCInlineColorInlayHintsProvider"/>
        <typedHandler implementation="com.cozooo.dlc_manager.dc.DCTypedHandler"/>
        <backspaceHandlerDelegate implementation="com.cozooo.dlc_manager.dc.DCBackspaceHandler"/>
        <externalAnnotator language="DC" implementationClass="com.cozooo.dlc_manager.dc.DCExternalAnnotator"/>
        <lang.documentationProvider language="DC" implementationClass="com.cozooo.dlc_manager.dc.DCDocumentationProvider"/>
        <formattingService implementation="com.cozooo.dlc_manager.dc.DCFormattingService"/>
        <notificationGroup id="DC Language Server" displayType="BALLOON"/>
        <postStartupActivity implementation="com.cozooo.dlc_manager.dc.DCLanguageServerStartupActivity"/>
    </extensions>
</idea-plugin>
